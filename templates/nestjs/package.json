{
  "name": "next-friday-template-nestjs",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS HTTP API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/next-friday/next-friday-template-nestjs.git"
  },
  "license": "UNLICENSED",
  "author": "Next Friday",
  "type": "module",
  "scripts": {
    "bands:check": "node scripts/check-bands.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm verify:static && pnpm test:changed && pnpm build",
    "clean": "rm -rf dist coverage .eslintcache node_modules/.cache",
    "debug:build": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "debug:serve": "node --env-file-if-exists=.env --inspect --watch dist/main.js",
    "depcruise": "depcruise --config .dependency-cruiser.json src test eslint.config.ts vitest.config.ts vitest.e2e.config.ts",
    "dev:build": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:serve": "node --env-file-if-exists=.env --watch dist/main.js",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache . && editorconfig-checker",
    "gates:check": "node scripts/check-agent-gates.ts",
    "knip": "knip",
    "lint": "eslint . --fix --cache --max-warnings=0 --no-inline-config",
    "lint:check": "eslint . --cache --max-warnings=0 --no-inline-config",
    "loop:measure": "node scripts/measure-loop.ts",
    "plan:check": "node scripts/check-plan.ts",
    "prepare": "husky",
    "rules:check": "node scripts/sync-agent-rules.ts --check",
    "rules:sync": "node scripts/sync-agent-rules.ts",
    "sort-package-json": "sort-package-json package.json",
    "sort-package-json:check": "sort-package-json --check package.json",
    "start": "pnpm build && node --env-file-if-exists=.env dist/main.js",
    "start:debug": "pnpm build && pnpm run \"/^debug:/\"",
    "start:dev": "pnpm build && pnpm run \"/^dev:/\"",
    "start:prod": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:changed": "if git rev-parse --quiet --verify origin/main > /dev/null && git diff --quiet \"$(git merge-base origin/main HEAD)\" -- pnpm-lock.yaml pnpm-workspace.yaml \"*package.json\" \"*tsconfig.json\" .husky; then vitest run --changed origin/main --passWithNoTests; else vitest run --passWithNoTests; fi",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "pnpm verify:static && pnpm test:coverage && pnpm test:e2e && pnpm build",
    "verify:static": "pnpm rules:check && pnpm gates:check && pnpm plan:check && pnpm bands:check && pnpm lint:check && pnpm format:check && pnpm sort-package-json:check && pnpm typecheck && pnpm knip && pnpm depcruise"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/terminus": "12.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@nestjs/testing": "12.4.0",
    "@next-friday/commitlint-config-friday": "5.2.1",
    "@next-friday/eslint-config-friday": "5.2.1",
    "@next-friday/prettier-config-friday": "5.2.1",
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "editorconfig-checker": "7.0.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "knip": "6.44.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "sort-package-json": "4.1.0",
    "supertest": "7.3.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
